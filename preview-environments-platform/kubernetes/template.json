[
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "name": "NAMESPACE",
      "labels": {
        "preview-owner": "gitlab",
        "gitlab-project": "PROJECT_ID",
        "gitlab-mr": "MR_ID"
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ResourceQuota",
    "metadata": {
      "name": "budget",
      "namespace": "NAMESPACE"
    },
    "spec": {
      "hard": {
        "requests.cpu": "1",
        "requests.memory": "512Mi",
        "limits.cpu": "2",
        "limits.memory": "1Gi",
        "pods": "5",
        "persistentvolumeclaims": "0",
        "services": "3",
        "secrets": "5"
      }
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "isolated",
      "namespace": "NAMESPACE"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": [
        "Ingress",
        "Egress"
      ],
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "traefik"
                }
              }
            },
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "monitoring"
                }
              }
            }
          ]
        }
      ],
      "egress": [
        {
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "kube-system"
                }
              }
            }
          ],
          "ports": [
            {
              "protocol": "UDP",
              "port": 53
            },
            {
              "protocol": "TCP",
              "port": 53
            }
          ]
        }
      ]
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "app",
      "namespace": "NAMESPACE"
    },
    "spec": {
      "replicas": 1,
      "revisionHistoryLimit": 5,
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        }
      },
      "selector": {
        "matchLabels": {
          "app": "preview"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "preview"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "containers": [
            {
              "name": "app",
              "image": "APP_IMAGE",
              "imagePullPolicy": "IfNotPresent",
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080
                }
              ],
              "env": [
                {
                  "name": "REVIEW_ID",
                  "value": "NAMESPACE"
                },
                {
                  "name": "ENVIRONMENT",
                  "value": "NAMESPACE"
                },
                {
                  "name": "RELEASE",
                  "value": "APP_IMAGE"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "100m",
                  "memory": "64Mi"
                },
                "limits": {
                  "cpu": "500m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": "http"
                },
                "periodSeconds": 5,
                "timeoutSeconds": 4
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 10
              }
            }
          ],
          "topologySpreadConstraints": []
        }
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "app",
      "namespace": "NAMESPACE",
      "labels": {
        "observe": "app"
      }
    },
    "spec": {
      "selector": {
        "app": "preview"
      },
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "targetPort": "http"
        }
      ]
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "name": "review",
      "namespace": "NAMESPACE"
    },
    "spec": {
      "ingressClassName": "traefik",
      "rules": [
        {
          "host": "REVIEW_HOST",
          "http": {
            "paths": [
              {
                "path": "/",
                "pathType": "Prefix",
                "backend": {
                  "service": {
                    "name": "app",
                    "port": {
                      "number": 8080
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
]